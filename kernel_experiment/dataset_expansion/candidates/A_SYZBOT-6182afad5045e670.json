      "path": "net/rxrpc/peer_event.c",
      "changed_lines": [
        "+/*",
        "+ * Reconstruct the last transmission time.  The difference calculated should be",
        "+ * valid provided no more than ~68 years elapsed since the last transmission.",
        "+ */",
        "+static time64_t rxrpc_peer_get_tx_mark(const struct rxrpc_peer *peer, time64_t base)",
        "+{",
        "+\ts32 last_tx_at = READ_ONCE(peer->last_tx_at);",
        "+\ts32 base_lsw = base;",
        "+\ts32 diff = last_tx_at - base_lsw;",
        "+",
        "+\tdiff = clamp(diff, -RXRPC_KEEPALIVE_TIME, RXRPC_KEEPALIVE_TIME);",
        "+",
        "+\treturn diff + base;",
        "+}",
        "+",
        "-\t\t\tkeepalive_at = peer->last_tx_at + RXRPC_KEEPALIVE_TIME;",
        "+\t\t\tkeepalive_at = rxrpc_peer_get_tx_mark(peer, base) + RXRPC_KEEPALIVE_TIME;"
      ],
