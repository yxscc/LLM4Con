        "+\t/* The sk_lock has mutex_lock() semantics here. */",
        "+\tmutex_acquire(&sk->sk_lock.dep_map, 0, 0, _RET_IP_);",
        "+",
        "-\tif (!sk->sk_lock.owned)",
        "+\tif (!sk->sk_lock.owned) {",
        "-\t\t * Note : We must disable BH",
        "+\t\t * Fast path return with bottom halves disabled and",
        "+\t\t * sock::sk_lock.slock held.",
        "+\t\t *",
        "+\t\t * The 'mutex' is not contended and holding",
        "+\t\t * sock::sk_lock.slock prevents all other lockers to",
        "+\t\t * proceed so the corresponding unlock_sock_fast() can",
        "+\t\t * avoid the slow path of release_sock() completely and",
        "+\t\t * just release slock.",
        "+\t\t *",
        "+\t\t * From a semantical POV this is equivalent to 'acquiring'",
        "+\t\t * the 'mutex', hence the corresponding lockdep",
        "+\t\t * mutex_release() has to happen in the fast path of",
        "+\t\t * unlock_sock_fast().",
        "+\t}",
        "-\tspin_unlock(&sk->sk_lock.slock);",
        "-\t/*",
        "-\t * The sk_lock has mutex_lock() semantics here:",
        "-\t */",
        "-\tmutex_acquire(&sk->sk_lock.dep_map, 0, 0, _RET_IP_);",
        "-\tlocal_bh_enable();",
        "+\tspin_unlock_bh(&sk->sk_lock.slock);"
