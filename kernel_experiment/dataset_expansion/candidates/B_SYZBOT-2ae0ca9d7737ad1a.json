        "+#include <asm/tlbflush.h>",
        "+",
        "+#include \"internal.h\"",
        "+",
        "+#undef pr_fmt",
        "+#define pr_fmt(fmt) \"secretmem: \" fmt",
        "+",
        "+/*",
        "+ * Define mode and flag masks to allow validation of the system call",
        "+ * parameters.",
        "+ */",
        "+#define SECRETMEM_MODE_MASK\t(0x0)",
        "+#define SECRETMEM_FLAGS_MASK\tSECRETMEM_MODE_MASK",
        "+",
        "+struct secretmem_ctx {",
        "+\tunsigned int mode;",
        "+};",
        "+",
        "+static struct page *secretmem_alloc_page(gfp_t gfp)",
        "+{",
        "+\t/*",
        "+\t * FIXME: use a cache of large pages to reduce the direct map",
        "+\t * fragmentation",
        "+\t */",
        "+\treturn alloc_page(gfp | __GFP_ZERO);",
        "+}",
        "+",
        "+static vm_fault_t secretmem_fault(struct vm_fault *vmf)",
        "+{",
        "+\tstruct address_space *mapping = vmf->vma->vm_file->f_mapping;",
        "+\tstruct inode *inode = file_inode(vmf->vma->vm_file);",
        "+\tpgoff_t offset = vmf->pgoff;",
        "+\tunsigned long addr;",
        "+\tstruct page *page;",
        "+\tint err;",
        "+",
        "+\tif (((loff_t)vmf->pgoff << PAGE_SHIFT) >= i_size_read(inode))",
        "+\t\treturn vmf_error(-EINVAL);",
        "+",
        "+retry:",
        "+\tpage = find_lock_page(mapping, offset);",
        "+\tif (!page) {",
        "+\t\tpage = secretmem_alloc_page(vmf->gfp_mask);",
        "+\t\tif (!page)",
        "+\t\t\treturn VM_FAULT_OOM;",
        "+",
        "+\t\terr = set_direct_map_invalid_noflush(page, 1);",
        "+\t\tif (err) {",
        "+\t\t\tput_page(page);",
        "+\t\t\treturn vmf_error(err);",
        "+\t\t}",
        "+",
        "+\t\t__SetPageUptodate(page);",
        "+\t\terr = add_to_page_cache(page, mapping, offset, vmf->gfp_mask);",
        "+\t\tif (unlikely(err)) {",
        "+\t\t\tput_page(page);",
        "+\t\t\tif (err == -EEXIST)",
        "+\t\t\t\tgoto retry;",
        "+\t\t\tgoto err_restore_direct_map;",
        "+\t\t}",
        "+",
        "+\t\taddr = (unsigned long)page_address(page);",
        "+\t\tflush_tlb_kernel_range(addr, addr + PAGE_SIZE);",
        "+\t}",
        "+",
        "+\tvmf->page = page;",
        "+\treturn VM_FAULT_LOCKED;",
        "+",
        "+err_restore_direct_map:",
        "+\t/*",
        "+\t * If a split of large page was required, it already happened",
        "+\t * when we marked the page invalid which guarantees that this call",
        "+\t * won't fail",
        "+\t */",
        "+\tset_direct_map_default_noflush(page, 1);",
        "+\treturn vmf_error(err);",
        "+}",
        "+"
