      "changed_lines": [
        "+/* Variable used to make lockdep treat read_lock() as recursive in selftests */",
        "+#ifdef CONFIG_DEBUG_LOCKING_API_SELFTESTS",
        "+extern unsigned int force_read_lock_recursive;",
        "+#else /* CONFIG_DEBUG_LOCKING_API_SELFTESTS */",
        "+#define force_read_lock_recursive 0",
        "+#endif /* CONFIG_DEBUG_LOCKING_API_SELFTESTS */",
        "+",
        "+#ifdef CONFIG_LOCKDEP",
        "+extern bool read_lock_is_recursive(void);",
        "+#else /* CONFIG_LOCKDEP */",
        "+/* If !LOCKDEP, the value is meaningless */",
        "+#define read_lock_is_recursive() 0",
        "+#endif",
        "+",
        "-#define rwlock_acquire_read(l, s, t, i)\t\tlock_acquire_shared_recursive(l, s, t, NULL, i)",
        "+#define rwlock_acquire_read(l, s, t, i)\t\t\t\t\t\\",
        "+do {\t\t\t\t\t\t\t\t\t\\",
        "+\tif (read_lock_is_recursive())\t\t\t\t\t\\",
        "+\t\tlock_acquire_shared_recursive(l, s, t, NULL, i);\t\\",
        "+\telse\t\t\t\t\t\t\t\t\\",
        "+\t\tlock_acquire_shared(l, s, t, NULL, i);\t\t\t\\",
        "+} while (0)",
        "+"
