        "-",
        "-\tfor_each_possible_cpu(cpu) {",
        "-\t\tmemcg_path = per_cpu_ptr(&memcg_paths, cpu);",
        "-\t\t*(old++) = rcu_dereference_protected(memcg_path->buf,",
        "-\t\t\tlockdep_is_held(&reg_lock));",
        "-\t\trcu_assign_pointer(memcg_path->buf, NULL);",
        "-\t}",
        "-",
        "-\t/* Wait for inflight memcg_path_buf users to finish. */",
        "-\tsynchronize_rcu();",
        "-",
        "-\told = tmp_bufs;",
        "-\tfor_each_possible_cpu(cpu) {",
        "-\t\tkfree(*(old++));",
        "-\t}",
        "-",
        "-\tkfree(tmp_bufs);",
        "-\ttmp_bufs = NULL;",
        "-}",
        "-",
        "-\tint cpu;",
        "-\tchar *new;",
        "-",
        "-\tmutex_lock(&reg_lock);",
        "-",
        "-\t/* If the refcount is going 0->1, proceed with allocating buffers. */",
        "-\tif (reg_refcount++)",
        "-\t\tgoto out;",
        "-",
        "-\ttmp_bufs = kmalloc_array(num_possible_cpus(), sizeof(*tmp_bufs),",
        "-\t\t\t\t GFP_KERNEL);",
        "-\tif (tmp_bufs == NULL)",
        "-\t\tgoto out_fail;",
        "-",
        "-\tfor_each_possible_cpu(cpu) {",
        "-\t\tnew = kmalloc(MEMCG_PATH_BUF_SIZE * CONTEXT_COUNT, GFP_KERNEL);",
        "-\t\tif (new == NULL)",
        "-\t\t\tgoto out_fail_free;",
        "-\t\trcu_assign_pointer(per_cpu_ptr(&memcg_paths, cpu)->buf, new);",
        "-\t\t/* Don't need to wait for inflights, they'd have gotten NULL. */",
        "-\t}",
        "-",
        "-out:",
        "-\tmutex_unlock(&reg_lock);",
        "+\tatomic_inc(&reg_refcount);",
        "-",
        "-out_fail_free:",
        "-\tfree_memcg_path_bufs();",
        "-out_fail:",
        "-\t/* Since we failed, undo the earlier ref increment. */",
        "-\t--reg_refcount;",
        "-",
        "-\tmutex_unlock(&reg_lock);",
        "-\treturn -ENOMEM;",
        "-\tmutex_lock(&reg_lock);",
        "-",
        "-\t/* If the refcount is going 1->0, proceed with freeing buffers. */",
        "-\tif (--reg_refcount)",
        "-\t\tgoto out;",
        "-",
