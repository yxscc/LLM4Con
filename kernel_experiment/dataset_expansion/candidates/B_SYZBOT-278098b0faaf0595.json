        "+/* Check if a potential BBT block is marked as bad */",
        "+static int bbt_block_checkbad(struct nand_chip *this, struct nand_bbt_descr *td,",
        "+\t\t\t      loff_t offs, uint8_t *buf)",
        "+{",
        "+\tstruct nand_bbt_descr *bd = this->badblock_pattern;",
        "+",
        "+\t/*",
        "+\t * No need to check for a bad BBT block if the BBM area overlaps with",
