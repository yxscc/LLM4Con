      "path": "fs/pipe.c",
      "changed_lines": [
        "+\t/*",
        "+\t * Reject writing to watch queue pipes before the point where we lock",
        "+\t * the pipe.",
        "+\t * Otherwise, lockdep would be unhappy if the caller already has another",
        "+\t * pipe locked.",
        "+\t * If we had to support locking a normal pipe and a notification pipe at",
        "+\t * the same time, we could set up lockdep annotations for that, but",
        "+\t * since we don't actually need that, it's simpler to just bail here.",
        "+\t */",
        "+\tif (pipe_has_watch_queue(pipe))",
        "+\t\treturn -EXDEV;",
        "+",
        "-\tif (pipe_has_watch_queue(pipe)) {",
        "-\t\tret = -EXDEV;",
        "-\t\tgoto out;",
        "-\t}",
        "-"
      ],
