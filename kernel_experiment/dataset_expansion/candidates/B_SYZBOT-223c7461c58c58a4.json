      "changed_lines": [
        "+\tunsigned long flags;",
        "+\t/*",
        "+\t * Explicitly disable this CPU's interrupts before taking seqlock",
        "+\t * to prevent any IRQ handler from calling into the page allocator",
        "+\t * (e.g. GFP_ATOMIC) that could hit zonelist_iter_begin and livelock.",
        "+\t */",
        "+\tlocal_irq_save(flags);",
        "+\t/*",
        "+\t * Explicitly disable this CPU's synchronous printk() before taking",
        "+\t * seqlock to prevent any printk() from trying to hold port->lock, for",
        "+\t * tty_insert_flip_string_and_push_buffer() on other CPU might be",
        "+\t * calling kmalloc(GFP_ATOMIC | __GFP_NOWARN) with port->lock held.",
        "+\t */",
        "+\tprintk_deferred_enter();",
        "+\tprintk_deferred_exit();",
        "+\tlocal_irq_restore(flags);"
