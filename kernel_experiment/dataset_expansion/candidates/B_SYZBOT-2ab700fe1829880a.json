      "path": "drivers/i2c/busses/i2c-mv64xxx.c",
      "changed_lines": [
        "+\t\t/*",
        "+\t\t * It seems that sometime the controller updates the status",
        "+\t\t * register only after it asserts IFLG in control register.",
        "+\t\t * This may result in weird bugs when in atomic mode. A delay",
        "+\t\t * of 100 ns before reading the status register solves this",
        "+\t\t * issue. This bug does not seem to appear when using",
        "+\t\t * interrupts.",
        "+\t\t */",
        "+\t\tif (drv_data->atomic)",
        "+\t\t\tndelay(100);",
        "+"
      ],
