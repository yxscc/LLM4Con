        "-\tstruct rw_semaphore io_order_lock;",
        "+\tstruct f2fs_rwsem io_order_lock;",
        "-\tstruct rw_semaphore cp_global_sem;\t/* checkpoint procedure lock */",
        "-\tstruct rw_semaphore cp_rwsem;\t\t/* blocking FS operations */",
