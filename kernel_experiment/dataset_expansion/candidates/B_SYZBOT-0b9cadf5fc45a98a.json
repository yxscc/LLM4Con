        "+\tstruct f2fs_rwsem pin_sem;",
        "+static inline void init_f2fs_rwsem(struct f2fs_rwsem *sem)",
        "+{",
        "+\tinit_rwsem(&sem->internal_rwsem);",
        "+\tinit_waitqueue_head(&sem->read_waiters);",
        "+}",
        "+",
        "+static inline int f2fs_rwsem_is_locked(struct f2fs_rwsem *sem)",
        "+{",
        "+\treturn rwsem_is_locked(&sem->internal_rwsem);",
        "+}",
        "+",
